<script>
  const spotlight = document.getElementById('spotlight');
  document.addEventListener('mousemove', (e) => {
    spotlight.style.background = `radial-gradient(600px circle at ${e.clientX}px ${e.clientY}px, rgba(29, 78, 216, 0.15), transparent 80%)`;
  });
</script>

<script>
  const testimonials = [
    {
      quote: "OnPath did more than just help test and validate. They designed and implemented test methodologies and pointed out opportunities we weren't aware of. They really created a well-rounded approach as a true partner instead of just a vendor.",
      author: "Craig Roth",
      role: "Product Manager, ClearCaptions",
    },
    {
      quote: "Having OnPath as a partner gave me excellent flexibility to surge our testing resources when needed. If you need manual test support, OnPath is a great option to increase your capacity.",
      author: "Tom Steiger",
      role: "CTO, BioTRUST Nutrition",
    },
    {
      quote: "OnPath provides a solution that is no more costly than working with an offshore body shop, but delivers much more. The resource they put in place was smart and wrote up good defects.",
      author: "Douglas Knoll",
      role: "President, CodeRinger",
    },
    {
      quote: "We failed out of a lot of external vendors before working with OnPath. The model with a US person managing was able to bridge the common logistics problems of outsourcing QA. Brian is super responsive and easy to work with.",
      author: "Allison Reder",
      role: "COO, PAIRIN",
    },
    {
      quote: "Brian and his team were readily available to our needs and exceeded expectations.",
      author: "Robert Whent",
      role: "Founder, WeCam Technologies",
    },
  ];

  const quoteEl = document.getElementById('testimonial-quote');
  const citeEl = document.getElementById('testimonial-cite');
  const dotsEl = document.getElementById('testimonial-dots');
  const prevBtn = document.getElementById('testimonial-prev');
  const nextBtn = document.getElementById('testimonial-next');

  let current = 0;
  let autoplayTimer = null;

  function renderDots() {
    dotsEl.innerHTML = '';
    testimonials.forEach((_, i) => {
      const dot = document.createElement('button');
      dot.type = 'button';
      dot.setAttribute('role', 'tab');
      dot.setAttribute('aria-label', `Go to testimonial ${i + 1}`);
      dot.className = 'h-1.5 rounded-full transition-all ' + (i === current ? 'w-6 bg-teal-300' : 'w-1.5 bg-slate-600 hover:bg-slate-400');
      dot.addEventListener('click', () => goTo(i));
      dotsEl.appendChild(dot);
    });
  }

  function renderSlide() {
    const t = testimonials[current];
    quoteEl.classList.add('fade-out');
    citeEl.classList.add('fade-out');
    setTimeout(() => {
      quoteEl.textContent = `"${t.quote}"`;
      citeEl.textContent = `— ${t.author}, ${t.role}`;
      quoteEl.classList.remove('fade-out');
      citeEl.classList.remove('fade-out');
    }, 250);
    renderDots();
  }

  function goTo(index) {
    current = (index + testimonials.length) % testimonials.length;
    renderSlide();
    resetAutoplay();
  }

  function next() { goTo(current + 1); }
  function prev() { goTo(current - 1); }

  function resetAutoplay() {
    if (autoplayTimer) clearInterval(autoplayTimer);
    autoplayTimer = setInterval(next, 6000);
  }

  prevBtn.addEventListener('click', prev);
  nextBtn.addEventListener('click', next);

  const carousel = document.getElementById('testimonial-carousel');
  carousel.addEventListener('mouseenter', () => { if (autoplayTimer) clearInterval(autoplayTimer); });
  carousel.addEventListener('mouseleave', resetAutoplay);

  quoteEl.textContent = `"${testimonials[0].quote}"`;
  citeEl.textContent = `— ${testimonials[0].author}, ${testimonials[0].role}`;
  renderDots();
  resetAutoplay();
</script>
