# brianborg-x reads these from ~/Projects/onpath-org/operations/.env automatically.
# This file documents what it needs. Do NOT put real secrets here.

# Already present in operations/.env:
ANTHROPIC_API_KEY=...        # used to generate posts + reply angles
X_API_KEY=...                # reserved for future direct posting
X_API_SECRET=...
X_ACCESS_TOKEN=...
X_ACCESS_TOKEN_SECRET=...

# ADD THESE for email review delivery (Gmail app password — see README):
GMAIL_USER=brian@onpathtesting.com
GMAIL_APP_PASSWORD=...        # Google Account > Security > 2-Step > App passwords
REVIEW_EMAIL_TO=brian@onpathtesting.com   # optional; defaults to GMAIL_USER

# Optional overrides:
# BRIANBORG_X_MODEL=claude-sonnet-4-6
